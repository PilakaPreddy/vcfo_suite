  "actions": [
    {
      "id": "save-draft",
      "label": "Save",
      "kind": "safe",
      "match": {
        "text": "Save"
      }
    },
    {
      "id": "check-form",
      "label": "Check form",
      "kind": "safe",
      "match": {
        "text": "Check form"
      }
    },
    {
      "id": "download-pdf",
      "label": "Download PDF",
      "kind": "safe",
      "match": {
        "text": "Download PDF"
      }
    },
    {
      "id": "attach-pdf",
      "label": "Attach PDF",
      "kind": "safe",
      "match": {
        "css": "#signed-pdf"
      }
    },
    {
      "id": "submit",
      "label": "Submit",
      "kind": "human",
      "match": {
        "text": "Submit"
      }
    },
    {
      "id": "pay",
      "label": "Pay",
      "kind": "human",
      "match": {
        "text": "Pay"
      }
