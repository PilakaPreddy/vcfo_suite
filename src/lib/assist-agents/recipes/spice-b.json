    {
      "id": "srn",
      "kind": "srn",
      "pattern": "\\b[A-Z]{1,2}\\d{7,8}\\b"
    },
    {
      "id": "saved",
      "kind": "text",
      "pattern": "[Ss]aved successfully"
    },
    {
      "id": "checked",
      "kind": "text",
      "pattern": "[Cc]heck passed"
    },
    {
      "id": "pdf-ready",
      "kind": "text",
      "pattern": "PDF ready"
    }
  ]
