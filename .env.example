# =====================================================================
# VCFO Suite — environment configuration
# Copy this file to `.env.local` and fill in.  The values below are the
# LOCAL (laptop / office-server) defaults that match docker-compose.yml.
# Comments show what changes when you move to AWS.
# =====================================================================

# ---------- Database (Postgres) ----------
# LOCAL ONLY: the Postgres container from docker-compose.yml.
DATABASE_URL="postgresql://vcfo:vcfo_local_dev@localhost:5432/vcfo"
# AWS (M7): there is NO DATABASE_URL. RDS is private (App Runner reaches it through a
# VPC connector) and its master password is the RDS-managed secret, rotated every 7 days.
# The app reads the password per new connection, so a rotation needs no redeploy.
# Terraform (infra/app.tf) sets these on App Runner:
# DB_SECRET_ARN="arn:aws:secretsmanager:ap-south-1:<account>:secret:rds!db-..."
# DB_HOST="vcfo-suite-db.<id>.ap-south-1.rds.amazonaws.com"
# DB_PORT="5432"
# DB_NAME="vcfo"
# DB_USER="vcfo"
# Only for a laptop script through the SSM tunnel on the NAT instance (DB_HOST=127.0.0.1):
# the RDS endpoint, so TLS still checks the real certificate name.
# `node scripts/db-env-prod.mjs` prints all of these. Never open RDS to the internet.
# DB_SSL_SERVERNAME="vcfo-suite-db.<id>.ap-south-1.rds.amazonaws.com"

# ---------- Auth.js (NextAuth) ----------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-secret"
# Rotation without sign-outs (M7, SOC 2 exception 371, every 90 days): put the old value
# here and the new one in AUTH_SECRET. New tokens use AUTH_SECRET; old ones still verify.
# Remove it 30 days after the rotation. AWS: vcfo-suite/AUTH_SECRET_PREVIOUS.
# AUTH_SECRET_PREVIOUS=""
# LOCAL: your machine. For office-server / phone / Cloudflare quick tunnel:
#   1) Leave AUTH_URL unset (AUTH_TRUST_HOST=true). Auth.js rewrites the request
#      origin to AUTH_URL when it is set (next-auth `reqWithEnvURL`), so pinning
#      http://localhost:3000 or a *.trycloudflare.com URL breaks the other host.
#      Quick tunnel hostnames also rotate every `cloudflared` run.
#   2) Use `npm run dev:lan` (or `npm run build && npm run start:lan`)
#   3) Optional: ALLOWED_DEV_ORIGINS / DEV_TUNNEL_HOST for next.config allow-list
# AWS:   https://app.yourdomain.com
# AUTH_URL="http://192.168.1.50:3000"
AUTH_TRUST_HOST="true"
# Microsoft sign-in for staff (S-650): the Microsoft Entra ID app registration. Leave all three
# empty to keep it off; Profile then shows "Not set up". Redirect URI to register in Entra:
#   {AUTH_URL}/api/auth/callback/microsoft-entra-id
# The issuer pins the firm's tenant, so accounts from other organisations cannot sign in. Sign-in
# links to an existing staff profile by email and never creates an account.
# AUTH_MICROSOFT_ENTRA_ID_ID="00000000-0000-0000-0000-000000000000"
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AWS (M7): instead of the value, the Secrets Manager secret name or ARN; read at runtime.
# AUTH_MICROSOFT_ENTRA_ID_SECRET_ID=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# Extra hosts for `next dev` `/_next/*` (LAN IP, ngrok, or a full URL).
# Cloudflare quick tunnels (`*.trycloudflare.com`) are already allow-listed —
# you do not need to paste the rotating hostname. Restart the dev server after
# changing these (`next.config` is read at boot).
# ALLOWED_DEV_ORIGINS="192.168.1.50,192.168.1.50:3000,my-app.ngrok-free.app"
# DEV_TUNNEL_HOST="my-app.ngrok-free.app"

# ---------- Object storage (S3 API) ----------
# LOCAL: MinIO from docker-compose.yml (S3-compatible)
# AWS:   remove S3_ENDPOINT (use real AWS), set region to ap-south-1,
#        and use an IAM role or access keys scoped to the bucket.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="vcfo-documents"
S3_ACCESS_KEY_ID="vcfo_minio"
S3_SECRET_ACCESS_KEY="vcfo_minio_local_dev"
S3_FORCE_PATH_STYLE="true"   # required for MinIO; set false / remove on AWS

# ---------- Email ----------
# Provider: "resend" (default) or "ses". Flip to ses only after AWS identity is verified.
EMAIL_PROVIDER="resend"
# Shared From (works for both providers). Legacy RESEND_FROM_EMAIL still works.
# Must be an address on your verified domain (e.g. sbctrack.in in Resend).
# Display name can be overridden per-send to show who initiated the mail
# (e.g. "Priya Sharma via VCFO Suite <info@sbctrack.in>").
# EMAIL_FROM="VCFO Suite <info@sbctrack.in>"
# Optional shared Reply-To / progress CC / local redirect (legacy RESEND_* aliases work).
# EMAIL_REPLY_TO="Support <support@mail.yourdomain.com>"
# EMAIL_PROGRESS_CC=""
# EMAIL_DEV_REDIRECT_TO=""

# --- Resend (default) ---
# Leave blank locally to log emails to console instead of sending.
RESEND_API_KEY=""
# Must be an address on a domain you verified in Resend (not personal Gmail/user inboxes).
# Client → lead process mail uses {company_name}@this-domain (e.g. acme-pvt-ltd@sbctrack.in)
# so leads can filter in Outlook. Tracking subdomain is for click links only.
RESEND_FROM_EMAIL="VCFO Suite <info@sbctrack.in>"
# Optional CC on client-facing progress mail (not used as a substitute for the lead).
RESEND_PROGRESS_CC=""
# Optional default Reply-To if a send path does not set one (usually unused — process
# mail sets Reply-To to the lead or client automatically).
# RESEND_REPLY_TO="Support <support@mail.yourdomain.com>"
# Optional: rewrite every outbound To/Cc to this address for local testing only.
# Do NOT set this to the client address — submit mail must reach the lead.
# RESEND_DEV_REDIRECT_TO=""
# For real multi-recipient delivery, verify a domain at resend.com/domains and
# set RESEND_FROM_EMAIL (or EMAIL_FROM) to an address on that domain (not @resend.dev).

# --- AWS SES (EMAIL_PROVIDER=ses) ---
# Verify domain/address in SES (same region). Prefer IAM role on App Runner; no keys needed then.
# SES_REGION="ap-south-1"
# SES_FROM_EMAIL="VCFO Suite <noreply@mail.yourdomain.com>"
# New SES accounts are sandboxed until you request production access.

# --- Microsoft Graph (lead → client Mail.Send) ---
# Azure app: delegated Mail.Send, User.Read, offline_access. Redirect:
#   {AUTH_URL}/api/outlook/callback
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""   # local dev
# AWS (M7, SOC 2 exception 372, rotated every 6 months): the secret's ARN or name instead of
# the value. The app reads it at runtime (cached 10 minutes, read again on invalid_client),
# so a rotation needs only `aws secretsmanager put-secret-value`, no redeploy.
# AZURE_AD_CLIENT_SECRET_SECRET_ID="vcfo-suite/AZURE_AD_CLIENT_SECRET"
# AZURE_AD_TENANT_ID=""   # firm tenant, or "common"

# ---------- Demo auth (leave OFF) ----------
# Read by src/context/use-app-provider-value.ts. When "true" it enables a
# password-less "sign in as client" shortcut for demos. Anything other than
# "true" (including unset, the default) disables it. Do NOT enable this on a
# machine other people can reach — it hands out a client session for free.
# NEXT_PUBLIC_ENABLE_DEMO_AUTH="true"
#
# Read by src/components/auth/demo-accounts.ts. When "on", the sign-in page shows
# one-click buttons for the seeded @vcfo.local demo accounts. Use it only for a
# local or LAN demo. Never set it in production: the buttons reveal demo logins.
# NEXT_PUBLIC_DEMO_LOGINS="on"

# ---------- Uploads ----------
NEXT_PUBLIC_MAX_UPLOAD_MB="50"

# ---------- App ----------
# Used for links inside emails / Outlook redirect URI (server-side). The browser
# always uses window.location.origin. Do not pin this to a *.trycloudflare.com
# URL — those hostnames rotate. Leave as localhost or unset for tunnel demos.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- WhatsApp notifications ----------
# Outbound-only nudges alongside email. Email stays the system of record: if
# WhatsApp is disabled, skipped or failing, every email still sends unchanged.
#
# Leave WHATSAPP_ENABLED=false (the default) and this whole feature is inert —
# no AWS call is made, and each attempt is recorded as `skipped/disabled`.
WHATSAPP_ENABLED=false

# ---------- AWS End User Messaging (Social) ----------
# The only WhatsApp transport. Sends on Meta's official Cloud API and bills the
# Meta fee + a small AWS fee on the AWS invoice, alongside SES, RDS and S3.
# Authenticates through the App Runner / ECS instance role — grant it
# `social-messaging:SendWhatsAppMessage`. No static keys here, same as SES.
#
# The transactional WhatsApp number is a SEPARATE WABA phone number under the
# existing verified Meta Business portfolio — not the DoubleTick number, which
# stays on its own integration for marketing. A number attaches to exactly one
# integration.

# Confirm EUM Social is available in this region before choosing it. It need
# not match SES_REGION. Falls back to AWS_REGION when unset.
SOCIAL_MESSAGING_REGION=""

# Origination phone number id from the EUM console, once the WABA is linked and
# the number registered. Formatted `phone-number-id-0123...`. Without it every
# attempt records `skipped/disabled` and no AWS call is made.
EUM_PHONE_NUMBER_ID=""

# Approved template language, and the pinned Meta Cloud API version.
WHATSAPP_TEMPLATE_LANG="en"
META_API_VERSION="v21.0"

# Delivery status and inbound opt-outs arrive as Amazon SNS notifications.
# Subscribe this HTTPS endpoint to the topic EUM publishes to; the route
# completes the subscription handshake itself. Every request is signature-
# verified against the AWS signing certificate.
AWS_EUM_SNS_WEBHOOK_URL="https://your-host/api/webhooks/aws-eum"
# Optional but recommended: pin the topic. A valid SNS signature proves a
# message came from SNS, not that it came from YOUR topic.
AWS_EUM_SNS_TOPIC_ARN=""

# Meta template names default to the event name itself (`welcome`,
# `coi_issued`, …) — approve them in WhatsApp Manager under exactly those
# names, category utility, and no per-event variable is needed here. Set an
# override only when a WABA template had to be named differently.
#   welcome                  1 first name, 2 company name
#   coi_issued               1 company name
#   document_delivered       1 company name, 2 step title
#   compliance_due_monthly   1 company name, 2 obligation name, 3 due date
#   compliance_due_quarterly 1 company name, 2 obligation name, 3 due date
#   compliance_overdue       1 company name, 2 obligation name
# Variable order must match the placeholder order in the approved body.
# Never put a CIN/PAN/TAN, filing number, password, OTP or document content in
# a template variable — the message says something needs attention and links to
# the portal.
# WHATSAPP_TEMPLATE_NAME_WELCOME=""
# WHATSAPP_TEMPLATE_NAME_COI_ISSUED=""
# WHATSAPP_TEMPLATE_NAME_DOCUMENT_DELIVERED=""
# WHATSAPP_TEMPLATE_NAME_COMPLIANCE_DUE_MONTHLY=""
# WHATSAPP_TEMPLATE_NAME_COMPLIANCE_DUE_QUARTERLY=""
# WHATSAPP_TEMPLATE_NAME_COMPLIANCE_OVERDUE=""
# WHATSAPP_TEMPLATE_NAME_CLIENT_REMINDER=""   # the one-click Remind (G-15); default name client_reminder
# C-868: the six-digit code sent before a person turns WhatsApp on (Settings). Name an approved
# AUTHENTICATION template with a copy-code button (body {{1}} = the code). It is not one of the
# events above and has no default: without it the Settings dialog skips the code step.
WHATSAPP_TEMPLATE_NAME_VERIFY_CODE=""

# --- Ask VCFO (in-app assistant) — see docs/specs/ask-vcfo/ASK-VCFO-CONTEXT.md §10 ---
# Off by default: hides the launcher and 404s every /api/ask route.
ASK_VCFO_ENABLED=false
# anthropic | bedrock
ASK_VCFO_LLM_PROVIDER=anthropic
# Server-only, local dev. Empty → free-text questions answer "unavailable"; suggestions and
# topics still work.
ANTHROPIC_API_KEY=
# AWS (M7, SOC 2 exception 376, rotated every 90 days): the secret's ARN or name. The app
# reads it at runtime (cached 10 minutes, read again on a 401), so no redeploy after a rotation.
# ANTHROPIC_API_KEY_SECRET_ID="/vcfo/ask-vcfo/anthropic-api-key"
# Only when ASK_VCFO_LLM_PROVIDER=bedrock (uses the AWS credential chain).
ASK_VCFO_BEDROCK_REGION=
ASK_VCFO_MODEL_GUARD=claude-haiku-5-5
ASK_VCFO_MODEL_ANSWER=claude-haiku-5-5
ASK_VCFO_MODEL_CONTEXTUALIZER=claude-haiku-4-5-20251001
# low | medium | high
ASK_VCFO_ANSWER_EFFORT=low
ASK_VCFO_RATE_LIMIT_HOUR=30
ASK_VCFO_RATE_LIMIT_DAY=200
ASK_VCFO_RETRIEVAL_TOP_K=4
# Server-side refusal fallback on the Anthropic API (set false to disable).
ASK_VCFO_REFUSAL_FALLBACK=true
# Firm name on "Reviewed by …" badges and PDF briefs.
NEXT_PUBLIC_FIRM_DISPLAY_NAME=SBC
# Ask VCFO proposed features (§9A), each off unless set to true:
# C1 daily nudge · C2 explain a delivered document · C3 "Why do we ask this?"
# C4 monthly status brief PDF · C5 "What if I miss it?" on compliance items
ASK_VCFO_FEATURE_C1=false
ASK_VCFO_FEATURE_C2=false
ASK_VCFO_FEATURE_C3=false
ASK_VCFO_FEATURE_C4=false
ASK_VCFO_FEATURE_C5=false
# A1 question gaps: admins see what clients ask (no client names); clients see a
# notice in the panel that the firm can see their questions.
ASK_VCFO_FEATURE_A1=false

# --- Ask VCFO: Answer, Do and Watch engines (docs/specs/ask-vcfo/BUILD-PLAN.md) ---
ASK_VCFO_MODEL_DOCUMENT=claude-haiku-5-5
ASK_VCFO_MODEL_EXTRACT=claude-haiku-5-5
ASK_VCFO_MODEL_WATCH=claude-haiku-5-5
ASK_VCFO_MODEL_AGENT=claude-sonnet-5-5
# bedrock | none. "none", or bedrock with no region, leaves vectors empty and search on full-text.
ASK_EMBEDDINGS_PROVIDER=none
ASK_EMBEDDINGS_REGION=
ASK_EMBEDDINGS_MODEL=amazon.titan-embed-text-v2:0
# Portal checks. When unset: off in production, on elsewhere. Keep off until the site terms are read.
WATCH_ENABLED=
# Firm mailbox that official alert emails go to; empty leaves the email route off.
WATCH_ALERT_MAILBOX=
# The shared token the mailbox relay sends to POST /api/watch/mail. Without both, that route answers 404.
WATCH_ALERT_TOKEN=
# Identity documents, extraction only and masked everywhere. Synthetic test data only until
# counsel has given a view on DPDP.
ASK_ID_DOC_READING=false
# "Prepare filing run" for VCFO Assist. Stays off until the written CS opinion exists.
ASK_ASSIST_HANDOFF_ENABLED=false
# Scheduled Do runs, which only ever create proposals.
ASK_PROACTIVE_ENABLED=false
# Kill switches, comma-separated. Paths are in src/lib/ask/paths.ts (e.g. agent_run,fixed_workflow,watch),
# tiers are T0 to T3 (T4 never runs at all).
ASK_KILL_PATHS=
ASK_KILL_TIERS=
ASK_RUN_MAX_TURNS=12
ASK_RUN_MAX_TOKENS=200000
ASK_DAILY_TOKEN_BUDGET=2000000
# Input plus output tokens for one chat answer across its tool rounds.
ASK_ANSWER_MAX_TOKENS=40000

# --- Client portal · Credentials vault (src/lib/credentials-crypto.ts) ---
# AES-256-GCM key for the secret cells (IDs, passwords, PAN, Aadhaar…) stored in
# engagement_credentials, and the HMAC key for credential OTP hashes.
# 32 bytes, base64 or hex:  openssl rand -base64 32
# REQUIRED in production. In development, if empty, a key is derived from AUTH_SECRET.
# Changing it makes stored secrets unreadable — re-encrypt before rotating.
# M7: it also seals two-step (TOTP) secrets, so an AUTH_SECRET rotation no longer touches
# them. Run `npm run totp:reencrypt` once after setting it. AWS: vcfo-suite/CREDENTIALS_ENCRYPTION_KEY.
CREDENTIALS_ENCRYPTION_KEY=

# ---------- Client portal: Customer support row (sidebar + Team page) ----------
# The "Customer support · SBC help desk" contact clients can WhatsApp, call,
# e-mail or Teams. Leave a value empty to hide that contact button.
CLIENT_SUPPORT_NAME="Customer support"
CLIENT_SUPPORT_EMAIL=""
CLIENT_SUPPORT_PHONE_E164=""
CLIENT_SUPPORT_WHATSAPP_E164=""

# ---------- Developer console (/app/dev, G-01) ----------
# Each reader shows "Not set up" while its variable is empty. The App Runner role
# also needs logs:FilterLogEvents, apprunner:DescribeService, apprunner:ListOperations
# and ce:GetCostAndUsage.
APP_LOG_GROUP=""
APP_RUNNER_SERVICE_ARN=""
# RDS instance identifier (not the ARN) for Data and costs › Backups: snapshot list and
# "Take snapshot now". IAM: rds:DescribeDBInstances, rds:DescribeDBSnapshots,
# rds:CreateDBSnapshot (and rds:AddTagsToResource) on the instance.
RDS_INSTANCE_ID=""
# "on" turns on the Cost Explorer reader (it is billed per request).
AWS_COST_EXPLORER=""
# M7 SOC 2 cards. Each card shows "Not connected" when the app role has no read access
# (grants in infra/soc-runtime.tf). Terraform sets the first two on App Runner.
# BACKUP_PLAN_ID: the AWS Backup plan vcfo-suite-db (Data and costs › Backups).
BACKUP_PLAN_ID=""
BACKUP_VAULT_NAME=""
# Network card. The VPC connector is read from APP_RUNNER_SERVICE_ARN when this is empty;
# the NAT instance is found by its project tag and a "nat" name when NAT_INSTANCE_ID is empty.
APP_RUNNER_VPC_CONNECTOR_ARN=""
NAT_INSTANCE_ID=""
# Secrets and rotation reads DescribeSecret on vcfo-suite/AUTH_SECRET by default.
# AUTH_SECRET_SECRET_ID=""
# Inngest REST reads for the Jobs screen; INNGEST_API_BASE_URL points at a local dev server.
INNGEST_SIGNING_KEY=""
INNGEST_API_BASE_URL=""

# ---------- Public "Book a demo" form (/contact, G-30) ----------
# Where demo requests are e-mailed. Empty falls back to the firm settings support e-mail.
DEMO_REQUEST_TO=""

# ---------- VCFO Assist (the browser extension in ../vcfo_assist) ----------
# "on" turns on the Assist parts of the obligation, filing and registration records and the
# routes the extension posts to (/api/assist/engagements/[id]/runs and .../result), plus the MCA
# filing card and its routes (docs/context/notes/assist-filing.md). Empty: the parts show
# "Not set up", the MCA filing card is hidden and the routes answer 503.
VCFO_ASSIST_ENABLED=""

# ---------- Receivables FX rates (Phase 9, the receivables-fx-rates job at 14:30 IST) ----------
# FX_RATE_SOURCE_URL: an FBIL-compatible endpoint (a mirror, a vendor feed or an internal proxy)
# that answers with the day's USD/INR reference rate as JSON; it is asked first and the rate is
# stored with source "fbil". Empty skips it.
FX_RATE_SOURCE_URL=""
# FX_FRANKFURTER_URL: the Frankfurter API base, the fallback (ECB reference rates, stored with
# source "ecb"). Empty uses https://api.frankfurter.dev/v1.
FX_FRANKFURTER_URL=""
