{
  "name": "vcfo-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run db:up && npm run css:portal",
    "dev": "next dev",
    "predev:lan": "npm run db:up && npm run css:portal",
    "dev:lan": "next dev -H 0.0.0.0 -p 3000",
    "prebuild": "npm run css:portal",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "css:portal": "node scripts/cp-css.mjs",
    "tokens": "node scripts/design-tokens-css.mjs --write",
    "tokens:check": "node scripts/design-tokens-check.mjs",
    "ask:knowledge:load": "node --conditions=react-server --import tsx scripts/ask-load-knowledge.ts",
    "ask:embed": "node --conditions=react-server --import tsx scripts/ask-embed-backfill.ts",
    "ask:topics:report": "node --conditions=react-server --import tsx scripts/ask-topics-report.ts",
    "ask:topics:publish": "node --conditions=react-server --import tsx scripts/ask-topics-publish.ts",
    "eval:knowledge": "ASK_EVAL_DB=1 vitest run tests/ask/evals/knowledge-db.test.ts",
    "eval:knowledge:live": "node --conditions=react-server --import tsx tests/ask/evals/run-knowledge-live.ts",
    "eval:live": "node --conditions=react-server --import tsx tests/ask/evals/run-live.ts",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts --reporter=list",
    "db:up": "docker compose up -d --wait postgres minio",
    "db:down": "docker compose stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "db:seed-demo": "node --conditions=react-server --import tsx scripts/seed-demo.ts",
    "db:purge-demo": "node --conditions=react-server --import tsx scripts/purge-demo-data.ts",
    "receivables:seed-demo": "node --conditions=react-server --import tsx scripts/seed-receivables-demo.ts",
    "receivables:import": "node --conditions=react-server --import tsx scripts/import-receivables.ts",
    "compliance:generate": "node --conditions=react-server --import tsx scripts/compliance-generate.ts",
    "totp:reencrypt": "node --conditions=react-server --import tsx scripts/reencrypt-totp.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "inngest:dev": "npx inngest-cli@latest dev"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.0",
    "@anthropic-ai/sdk": "^0.129.0",
    "@aws-sdk/client-apprunner": "^3.1105.0",
    "@aws-sdk/client-backup": "^3.1160.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1163.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1105.0",
    "@aws-sdk/client-cost-explorer": "^3.1105.0",
    "@aws-sdk/client-ec2": "^3.1160.0",
    "@aws-sdk/client-rds": "^3.1160.0",
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/client-secrets-manager": "^3.1160.0",
    "@aws-sdk/client-sesv2": "^3.1108.0",
    "@aws-sdk/client-socialmessaging": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.665.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/react": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.100.13",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "docx-preview": "^0.3.7",
    "docxtemplater": "^3.68.7",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "inngest": "^3.27.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "pg": "^8.13.1",
    "pizzip": "^3.2.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "recharts": "^2.15.4",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^2.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.10",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.2.7"
  }
}
